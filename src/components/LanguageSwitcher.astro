---
import { type Alternates, type Locale, localeMeta, locales, localizePath, t } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** Traduzioni della pagina corrente; se manca una lingua si va alla sua home. */
  alternates: Alternates;
  class?: string;
}
const { locale, alternates, class: className = '' } = Astro.props;
---
<nav aria-label={t(locale).language} class:list={['flex items-center text-xs font-medium tracking-[0.12em] uppercase', className]}>
  {locales.map((l, i) => (
    <>
      {i > 0 && <span class="px-1.5 text-line" aria-hidden="true">/</span>}
      {l === locale ? (
        <span class="text-fg" aria-current="true" title={localeMeta[l].label}>{l}</span>
      ) : (
        <a href={alternates[l] ?? localizePath('/', l)} hreflang={localeMeta[l].htmlLang} lang={localeMeta[l].htmlLang}
          class="text-muted transition-colors hover:text-fg" title={localeMeta[l].label}>{l}</a>
      )}
    </>
  ))}
</nav>
