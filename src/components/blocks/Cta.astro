---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksCta } from '../../../tina/__generated__/types';
import Button from '../Button.astro';

interface Props {
  block: PageBlocksCta;
}
const { block } = Astro.props;
---
<section class="container-x py-10 md:py-14">
  <div class="rounded-3xl border border-primary/30 bg-gradient-to-br from-surface to-bg px-6 py-12 text-center md:px-12">
    {block.heading && <h2 class="text-3xl sm:text-4xl" data-tina-field={tinaField(block, 'heading')}>{block.heading}</h2>}
    {block.text && <p class="mx-auto mt-4 max-w-2xl text-lg text-muted" data-tina-field={tinaField(block, 'text')}>{block.text}</p>}
    {(block.buttons?.length ?? 0) > 0 && block.buttons && (
      <div class:list={['flex flex-wrap justify-center gap-3', (block.heading || block.text) && 'mt-8']} data-tina-field={tinaField(block, 'buttons')}>
        {block.buttons.map((b) => b && <Button href={b.href} variant={b.variant} data-tina-field={tinaField(b, 'label')}>{b.label}</Button>)}
      </div>
    )}
  </div>
</section>
