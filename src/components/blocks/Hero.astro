---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksHero } from '../../../tina/__generated__/types';
import Button from '../Button.astro';

interface Props {
  block: PageBlocksHero;
  first?: boolean;
}
const { block, first = false } = Astro.props;
const Heading = first ? 'h1' : 'h2';
const hasButtons = (block.buttons?.length ?? 0) > 0;
---
{block.image ? (
  <section class="border-b border-line">
    <div class="grid lg:min-h-[min(calc(100svh-4.5rem),54rem)] lg:grid-cols-[1.08fr_1fr]">
      <figure class="relative aspect-[4/3] overflow-hidden bg-surface sm:aspect-[16/10] lg:aspect-auto">
        <img src={block.image} alt={block.imageAlt ?? ''} width="1500" height="1300" loading="eager" fetchpriority="high"
          class="settle absolute inset-0 size-full object-cover" data-tina-field={tinaField(block, 'image')} />
      </figure>
      <div class="flex flex-col justify-center bg-surface px-4 py-14 sm:px-10 sm:py-16 lg:px-14 xl:px-20">
        <div class="max-w-xl">
          {block.eyebrow && <p class="rise eyebrow" data-tina-field={tinaField(block, 'eyebrow')}>{block.eyebrow}</p>}
          <Heading class="rise mt-6 text-[clamp(2.9rem,6.2vw,5.6rem)] leading-[0.98] [--i:1]" data-tina-field={tinaField(block, 'heading')}>{block.heading}</Heading>
          {block.body && (
            <div class="rise rich mt-7 max-w-md [--i:2]" data-tina-field={tinaField(block, 'body')}><TinaMarkdown content={block.body} /></div>
          )}
          {hasButtons && (
            <div class="rise mt-10 flex flex-wrap gap-3 [--i:3]" data-tina-field={tinaField(block, 'buttons')}>
              {block.buttons!.map((b) => b && <Button href={b.href} variant={b.variant} data-tina-field={tinaField(b, 'label')}>{b.label}</Button>)}
            </div>
          )}
          {block.note && <p class="rise mt-8 border-t border-line pt-6 text-sm text-muted [--i:4]" data-tina-field={tinaField(block, 'note')}>{block.note}</p>}
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="container-x py-20 text-center md:py-32">
    {block.eyebrow && <p class="rise eyebrow justify-center" data-tina-field={tinaField(block, 'eyebrow')}>{block.eyebrow}</p>}
    <Heading class="rise mx-auto mt-6 max-w-4xl text-[clamp(2.9rem,7vw,6rem)] leading-[0.98] [--i:1]" data-tina-field={tinaField(block, 'heading')}>{block.heading}</Heading>
    {block.body && <div class="rise rich mx-auto mt-7 max-w-xl [--i:2]" data-tina-field={tinaField(block, 'body')}><TinaMarkdown content={block.body} /></div>}
    {hasButtons && (
      <div class="rise mt-10 flex flex-wrap justify-center gap-3 [--i:3]" data-tina-field={tinaField(block, 'buttons')}>
        {block.buttons!.map((b) => b && <Button href={b.href} variant={b.variant} data-tina-field={tinaField(b, 'label')}>{b.label}</Button>)}
      </div>
    )}
    {block.note && <p class="rise mt-8 text-sm text-muted [--i:4]" data-tina-field={tinaField(block, 'note')}>{block.note}</p>}
  </section>
)}
