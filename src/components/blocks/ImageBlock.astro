---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksImage } from '../../../tina/__generated__/types';

interface Props {
  block: PageBlocksImage;
}
const { block } = Astro.props;
---
{block.image && (
  <section class="container-x py-6 md:py-10">
    <figure class="aspect-[16/9] overflow-hidden bg-surface md:aspect-[21/9]">
      <img src={block.image} alt={block.alt ?? ''} width="2000" height="900" loading="lazy" class="settle size-full object-cover" data-tina-field={tinaField(block, 'image')} />
    </figure>
  </section>
)}
