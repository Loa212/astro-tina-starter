---
import { tinaField } from '@tinacms/astro/tina-field';

import type { PageBlocksSteps } from '../../../tina/__generated__/types';

interface Props {
  block: PageBlocksSteps;
}
const { block } = Astro.props;
---
<section class="bg-surface/50 py-14 md:py-20">
  <div class="container-x">
    {block.heading && <h2 class="text-center text-3xl sm:text-4xl" data-tina-field={tinaField(block, 'heading')}>{block.heading}</h2>}
    <ol class="mt-12 grid gap-8 md:grid-cols-3" data-tina-field={tinaField(block, 'items')}>
      {block.items?.map((item, i) => item && (
        <li class="relative rounded-3xl border border-line/60 bg-bg p-7">
          <span class="grid size-12 place-items-center rounded-full bg-primary font-heading text-xl font-bold text-bg">{i + 1}</span>
          <h3 class="mt-5 text-xl" data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
          {item.text && <p class="mt-3 leading-relaxed text-muted" data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>
