---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksSteps } from '../../../tina/__generated__/types';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  block: PageBlocksSteps;
}
const { block } = Astro.props;
const items = (block.items ?? []).filter((i) => i !== null);
---
<section class="container-x py-20 md:py-28">
  <SectionHeader block={block} />
  <ol class:list={['grid gap-x-8 gap-y-12 sm:grid-cols-2', items.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3', (block.heading || block.intro) && 'mt-14 md:mt-16']} data-tina-field={tinaField(block, 'items')}>
    {items.map((item, i) => (
      <li class="reveal border-t border-fg pt-6">
        <span class="font-display text-6xl leading-none text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-8 text-xl" data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
        {item.text && <p class="mt-3 leading-relaxed text-muted" data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
      </li>
    ))}
  </ol>
</section>
