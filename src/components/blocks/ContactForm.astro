---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksContactForm } from '../../../tina/__generated__/types';
import { type Locale, localizePath, t } from '../../lib/i18n';
import Icon from '../Icon.astro';

interface Props {
  block: PageBlocksContactForm;
  locale: Locale;
}
const { block, locale } = Astro.props;
const ui = t(locale).form;
const turnstileKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const startedAt = Date.now();
const err = Astro.url.searchParams.get('error');
const serverMessage = err === 'fields' ? ui.errorFields : err === 'send' ? ui.errorSend : '';
---
<section id="contact-form" class="bg-surface py-20 md:py-28">
  <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <h2 class="text-4xl sm:text-5xl lg:text-6xl" data-tina-field={tinaField(block, 'heading')}>{block.heading ?? ui.defaultHeading}</h2>
      {block.intro && <p class="mt-6 max-w-md text-lg leading-relaxed text-muted" data-tina-field={tinaField(block, 'intro')}>{block.intro}</p>}
    </div>

    <form id="contact-form-el" method="post" action="/api/contact" class="space-y-6" novalidate
      data-msg-sending={ui.sending} data-msg-submit={ui.submit} data-msg-check={ui.checkFields} data-msg-network={ui.errorNetwork}>
      <input type="hidden" name="_startedAt" value={startedAt} />
      <input type="hidden" name="_lang" value={locale} />
      <div class="hidden" aria-hidden="true"><label>Website <input type="text" name="_website" tabindex="-1" autocomplete="off" /></label></div>
      <p id="contact-form-message" class:list={['rounded-md border border-red-700/30 bg-red-50 px-5 py-4 text-sm text-red-800', !serverMessage && 'hidden']} role="alert">{serverMessage}</p>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="field">{ui.name} *<input class="input" name="name" type="text" autocomplete="name" required /></label>
        <label class="field">{ui.email} *<input class="input" name="email" type="email" autocomplete="email" required /></label>
        <label class="field sm:col-span-2">{ui.phone}<input class="input" name="phone" type="tel" autocomplete="tel" /></label>
        <label class="field sm:col-span-2">{ui.message} *<textarea class="input min-h-40" name="message" required></textarea></label>
      </div>
      <label class="choice" data-group="privacy">
        <input type="checkbox" name="privacy" required />
        <span>{ui.consentBefore}<a href={localizePath('/privacy/', locale)} target="_blank" rel="noopener" class="text-fg underline decoration-accent/60 underline-offset-4">{ui.consentLink}</a>{ui.consentAfter}</span>
      </label>

      {turnstileKey && (
        <>
          <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )}

      <div class="flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-sm text-xs leading-relaxed text-muted">{ui.required}</p>
        <button type="submit" class="btn btn-primary shrink-0 disabled:opacity-60" data-submit><span data-submit-label>{ui.submit}</span><Icon name="arrow" class="-mr-1 size-4" /></button>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form-el') as HTMLFormElement | null;
  const message = document.getElementById('contact-form-message');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const submitLabel = form?.querySelector<HTMLElement>('[data-submit-label]');
  const msg = form?.dataset ?? {};

  function clearErrors() {
    form?.querySelectorAll('.error').forEach((e) => e.remove());
    form?.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
  }

  function showErrors(errors: Record<string, string>) {
    for (const [name, text] of Object.entries(errors)) {
      const input = form?.querySelector<HTMLElement>(`[name="${name}"]`);
      const anchor = form?.querySelector<HTMLElement>(`[data-group="${name}"]`) ?? input?.closest('label') ?? input;
      if (!anchor) continue;
      input?.setAttribute('aria-invalid', 'true');
      const p = document.createElement('p');
      p.className = 'error';
      p.textContent = text;
      anchor.insertAdjacentElement('afterend', p);
    }
    form?.querySelector('[aria-invalid], .error')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setMessage(text: string) {
    if (!message) return;
    message.textContent = text;
    message.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();
    message?.classList.add('hidden');
    if (submit) submit.disabled = true;
    if (submitLabel) submitLabel.textContent = msg.msgSending ?? '';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      const json = (await res.json()) as { ok: boolean; message?: string; errors?: Record<string, string>; redirect?: string };
      if (json.ok) { window.location.assign(json.redirect ?? '/thanks/'); return; }
      setMessage(json.message ?? msg.msgCheck ?? '');
      if (json.errors) showErrors(json.errors);
    } catch {
      setMessage(msg.msgNetwork ?? '');
    } finally {
      if (submit) submit.disabled = false;
      if (submitLabel) submitLabel.textContent = msg.msgSubmit ?? '';
    }
  });
</script>
