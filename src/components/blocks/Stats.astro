---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksStats } from '../../../tina/__generated__/types';

interface Props {
  block: PageBlocksStats;
}
const { block } = Astro.props;
const items = (block.items ?? []).filter((i) => i !== null);
---
{items.length > 0 && (
  <section class="container-x py-12 md:py-16">
    <dl class:list={['grid grid-cols-2 gap-px border-y border-line bg-line', items.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']} data-tina-field={tinaField(block, 'items')}>
      {items.map((item) => (
        <div class="flex flex-col-reverse justify-end gap-2 bg-bg px-1 py-7 sm:px-6 md:py-9">
          <dt class="text-sm text-muted" data-tina-field={tinaField(item, 'label')}>{item.label}</dt>
          <dd class="font-display text-5xl leading-none md:text-6xl" data-tina-field={tinaField(item, 'value')}>{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
