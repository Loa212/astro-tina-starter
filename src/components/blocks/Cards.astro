---
import { tinaField } from '@tinacms/astro/tina-field';

import type { PageBlocksCards } from '../../../tina/__generated__/types';

interface Props {
  block: PageBlocksCards;
}
const { block } = Astro.props;
---
<section class="container-x py-14 md:py-20">
  <div class="mx-auto max-w-3xl text-center">
    {block.intro && <p class="font-heading text-sm font-semibold uppercase tracking-[0.2em] text-primary" data-tina-field={tinaField(block, 'intro')}>{block.intro}</p>}
    {block.heading && <h2 class="mt-3 text-3xl sm:text-4xl" data-tina-field={tinaField(block, 'heading')}>{block.heading}</h2>}
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-3" data-tina-field={tinaField(block, 'items')}>
    {block.items?.map((item) => item && (
      <article class="rounded-3xl bg-surface p-7 transition-colors hover:bg-surface-2">
        <span class="block h-1 w-10 rounded-full bg-primary"></span>
        <h3 class="mt-5 text-xl" data-tina-field={tinaField(item, 'title')}>{item.title}</h3>
        {item.text && <p class="mt-3 leading-relaxed text-muted" data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
      </article>
    ))}
  </div>
</section>
