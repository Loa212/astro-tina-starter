---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlocksFaq } from '../../../tina/__generated__/types';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  block: PageBlocksFaq;
}
const { block } = Astro.props;
const items = (block.items ?? []).filter((i) => i !== null);
---
<section class="container-x py-20 md:py-28">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <SectionHeader block={block} class="lg:sticky lg:top-28 lg:self-start" />
    <div class="border-t border-line" data-tina-field={tinaField(block, 'items')}>
      {items.map((item, i) => (
        <details class="group border-b border-line" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
            <span data-tina-field={tinaField(item, 'question')}>{item.question}</span>
            <Icon name="plus" class="mt-1 size-5 shrink-0 text-muted transition-transform duration-300 group-open:rotate-45" />
          </summary>
          {item.answer && <div class="rich -mt-1 max-w-2xl pb-7 text-base" data-tina-field={tinaField(item, 'answer')}><TinaMarkdown content={item.answer} /></div>}
        </details>
      ))}
    </div>
  </div>
</section>
