---
import { formatDate, type Locale } from '../lib/i18n';
import type { PostSummary } from '../lib/tina/data';

interface Props {
  post: PostSummary;
  locale: Locale;
}
const { post, locale } = Astro.props;
---
<a href={post.href} class="group flex flex-col">
  <div class="aspect-[4/3] overflow-hidden bg-surface">
    {post.image && (
      <img src={post.image} alt="" width="800" height="600" loading="lazy"
        class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]" />
    )}
  </div>
  <div class="mt-5 flex items-center gap-3 text-xs font-medium uppercase tracking-[0.14em] text-muted">
    <time datetime={post.date}>{formatDate(post.date, locale)}</time>
    {post.tags[0] && <><span class="h-px w-4 bg-line" aria-hidden="true"></span><span>{post.tags[0]}</span></>}
  </div>
  <h3 class="mt-3 font-display text-3xl leading-[1.08] font-normal tracking-[-0.01em] text-balance decoration-accent/60 underline-offset-4 group-hover:underline">{post.title}</h3>
  {post.description && <p class="mt-3 line-clamp-2 leading-relaxed text-muted">{post.description}</p>}
</a>
