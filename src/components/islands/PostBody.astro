---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { formatDate, type PostData } from '../../lib/tina/data';

interface Props {
  post: PostData | undefined | null;
}
const { post } = Astro.props;
---
{post && (
  <article class="container-x py-14 md:py-20">
    <div class="mx-auto max-w-3xl">
      <a href="/blog/" class="font-heading text-sm font-semibold uppercase tracking-[0.2em] text-primary">← Blog</a>
      <h1 class="mt-4 text-4xl sm:text-5xl" data-tina-field={tinaField(post, 'title')}>{post.title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <time datetime={post.date} data-tina-field={tinaField(post, 'date')}>{formatDate(post.date)}</time>
        {post.tags?.filter(Boolean).map((tag) => <span class="rounded-full bg-surface px-3 py-1 text-xs uppercase tracking-wider">{tag}</span>)}
        {post.draft && <span class="rounded-full bg-primary px-3 py-1 text-xs font-semibold uppercase tracking-wider text-bg">Bozza</span>}
      </p>
      {post.description && <p class="mt-6 text-xl text-muted" data-tina-field={tinaField(post, 'description')}>{post.description}</p>}
      {post.image && <img src={post.image} alt="" width="1600" height="600" class="mt-8 w-full rounded-3xl object-cover" data-tina-field={tinaField(post, 'image')} />}
      <div class="rich mt-10" data-tina-field={tinaField(post, 'body')}><TinaMarkdown content={post.body} /></div>
    </div>
  </article>
)}
