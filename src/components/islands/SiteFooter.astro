---
import { tinaField } from '@tinacms/astro/tina-field';
import type { SettingsData } from '../../lib/tina/data';
import Icon from '../Icon.astro';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  settings: SettingsData | undefined | null;
}
const { settings } = Astro.props;
const year = new Date().getFullYear();
const wa = settings?.contacts?.whatsapp?.replace(/[^\d]/g, '');
---
<footer class="mt-auto border-t border-line/60 bg-surface/40">
  <div class="container-x grid gap-10 py-12 md:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-3">
        {settings?.logo && <img src={settings.logo} alt="" width="48" height="48" class="size-12 rounded-full object-cover" />}
        <span class="font-heading text-lg font-semibold uppercase tracking-wide">{settings?.siteName}</span>
      </a>
      {settings?.footerText && <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted" data-tina-field={tinaField(settings, 'footerText')}>{settings.footerText}</p>}
    </div>
    <div>
      <h2 class="font-heading text-sm font-semibold uppercase tracking-wider text-primary">Pagine</h2>
      <ul class="mt-4 space-y-2">
        {settings?.nav?.map((item) => item && (
          <li><a href={item.href} class="text-muted transition-colors hover:text-fg">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-sm font-semibold uppercase tracking-wider text-primary">Contatti</h2>
      <ul class="mt-4 space-y-2 text-muted">
        {wa && (
          <li><a href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-fg"><Icon name="whatsapp" class="size-4" /><span data-tina-field={tinaField(settings!.contacts!, 'whatsapp')}>{settings?.contacts?.whatsapp}</span></a></li>
        )}
        {settings?.contacts?.email && (
          <li><a href={`mailto:${settings.contacts.email}`} class="inline-flex items-center gap-2 transition-colors hover:text-fg"><Icon name="email" class="size-4" /><span data-tina-field={tinaField(settings.contacts, 'email')}>{settings.contacts.email}</span></a></li>
        )}
      </ul>
      <SocialLinks instagram={settings?.social?.instagram} facebook={settings?.social?.facebook} class="mt-4 -ml-2" />
    </div>
  </div>
  <div class="border-t border-line/60">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {settings?.siteName} – {settings?.tagline}</p>
      <span class="flex items-center gap-4"><a href="/privacy/" class="transition-colors hover:text-fg">Privacy e cookie</a><a href="/admin/index.html" class="opacity-50 transition-opacity hover:opacity-100">Area riservata</a></span>
    </div>
  </div>
</footer>
