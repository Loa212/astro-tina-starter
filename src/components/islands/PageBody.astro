---
import { localeOfPath } from '../../lib/i18n';
import type { PageData } from '../../lib/tina/data';
import BlockRenderer from '../blocks/BlockRenderer.astro';

interface Props {
  page: PageData | undefined | null;
}
const { page } = Astro.props;
---
{page && <BlockRenderer blocks={page.blocks} pageTitle={page.title} locale={localeOfPath(page._sys.relativePath)} />}
