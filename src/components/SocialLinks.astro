---
import Icon from './Icon.astro';

interface Props {
  instagram?: string | null;
  facebook?: string | null;
  class?: string;
}
const { instagram, facebook, class: className = '' } = Astro.props;
---
<ul class:list={['flex items-center gap-2', className]}>
  {instagram && (
    <li>
      <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
        class="grid size-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-primary">
        <Icon name="instagram" />
      </a>
    </li>
  )}
  {facebook && (
    <li>
      <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
        class="grid size-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-primary">
        <Icon name="facebook" />
      </a>
    </li>
  )}
</ul>
