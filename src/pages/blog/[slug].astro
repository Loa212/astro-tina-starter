---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PostBody from '../../components/islands/PostBody.astro';
import Base from '../../layouts/Base.astro';
import { getPost, getSettings } from '../../lib/tina/data';
import { islands } from '../../lib/tina/islands';

const slug = (Astro.params.slug ?? '').replace(/\/+$/, '');
if (!/^[a-z0-9-]+$/.test(slug)) return Astro.rewrite('/404');

const [post, settings] = await Promise.all([getPost(slug).catch(() => null), getSettings()]);
const data = post?.data?.post;
// Le bozze si vedono solo dentro l'editor.
if (!data || (data.draft && !Astro.locals.tinaEdit)) return Astro.rewrite('/404');
---
<Base title={data.title} description={data.description} settings={settings.data.settings} image={data.image} noindex={Boolean(data.draft)}>
  <TinaIsland name="post" wrapper={islands.post.wrapper} params={{ slug }} primary>
    <PostBody post={data} />
  </TinaIsland>
</Base>
