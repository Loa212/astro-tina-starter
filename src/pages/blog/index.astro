---
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import { getSettings, listPosts } from '../../lib/tina/data';

const [settings, posts] = await Promise.all([getSettings(), listPosts()]);
---
<Base title="Blog" description="Tutti gli articoli del blog." settings={settings.data.settings}>
  <main class="container-x flex-1 py-14 md:py-20">
    <p class="font-heading text-sm font-semibold uppercase tracking-[0.2em] text-primary">Blog</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Tutti gli articoli</h1>
    {posts.length === 0 ? (
      <p class="mt-10 text-lg text-muted">Nessun articolo pubblicato, per ora.</p>
    ) : (
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </main>
</Base>
