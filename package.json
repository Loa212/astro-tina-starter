{
  "name": "astro-tina-starter",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev -c \"astro dev\"",
    "build": "tinacms build --skip-cloud-checks --skip-indexing --noTelemetry && astro build && pnpm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "start:local": "TINA_PUBLIC_IS_LOCAL=false TINA_DB_PATH=.tina/local.db node --env-file-if-exists=.env dist/server.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.server.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "tina": "tinacms"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tinacms/astro": "^0.8.0",
    "@tinacms/datalayer": "^3.0.0",
    "@tinacms/graphql": "^4.0.1",
    "abstract-level": "^1.0.4",
    "astro": "^7.4.2",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "graphql": "15.8.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "sqlite-level": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "tinacms": "^3.15.0",
    "tinacms-authjs": "^24.0.5",
    "tinacms-gitprovider-github": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.2",
    "@tinacms/cli": "^4.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "description": "Starter: Astro SSR + Tailwind 4 + TinaCMS self-hosted (visual editing) + blog + form via Resend, in un solo container per Coolify",
  "packageManager": "pnpm@11.5.1"
}
