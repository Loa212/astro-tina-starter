# --- Modalità ---
# true  = sviluppo locale: contenuti letti dai file, admin senza login (tinacms dev)
# false = produzione: SQLite + GitHub + login username/password
TINA_PUBLIC_IS_LOCAL=false

# --- Database Tina (indice SQLite; in produzione su volume persistente) ---
TINA_DB_PATH=/data/tina.db

# --- Primo utente del CMS (creato all'avvio se il database è vuoto; poi si gestisce dall'admin) ---
TINA_ADMIN_USERNAME=admin
TINA_ADMIN_PASSWORD=
TINA_ADMIN_EMAIL=admin@example.com
# Opzionale: username (separati da virgola) autorizzati a gestire gli utenti dal pannello. Default: TINA_ADMIN_USERNAME
# TINA_ADMINS=admin,altro-utente

# --- Autenticazione admin (Auth.js) ---
# genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pubblico del backend Tina (dominio del sito + /api/tina)
NEXTAUTH_URL=https://example.com/api/tina

# --- GitHub: dove Tina salva i contenuti (commit sul branch) ---
GITHUB_OWNER=Loa212
GITHUB_REPO=nome-del-repo
GITHUB_BRANCH=main
# fine-grained PAT, solo questo repo, permesso "Contents: Read and write"
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Commit dell'immagine (Coolify lo imposta da solo; serve per saltare la re-indicizzazione) ---
# SOURCE_COMMIT=

# --- Modulo contatti: invio email via Resend ---
RESEND_API_KEY=
MAIL_TO=info@example.com
MAIL_FROM="Il mio sito <noreply@example.com>"

# --- Opzionale: Cloudflare Turnstile anti-spam sul modulo ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sito ---
# URL pubblico (canonical, Open Graph). Sul dominio provvisorio mettere quello, e NEXTAUTH_URL di conseguenza.
PUBLIC_SITE_URL=https://example.com
# true finché il sito è sul dominio provvisorio: aggiunge <meta name="robots" content="noindex"> a tutte le pagine
SITE_NOINDEX=false
PORT=3000
